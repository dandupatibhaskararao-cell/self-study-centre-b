<script>

const answers = {

q26:"39",
q27:"85",
q28:"90",
q29:"32",
q30:"54:36",

/* Q31 expression missing */
q31:null,

q32:"25",
q33:"53",
q34:"42",

/* Q35 expression gives 135, but option missing */
q35:null,

/* Q36 expression missing */
q36:null,

q37:"24",
q38:"90",
q39:"4190",
q40:"33",

/* Q41 expression missing */
q41:null,

q42:"63",
q43:"0.8",
q44:"216.8",
q45:"32.2",

/* Q46 expression missing */
q46:null,

q47:"40",
q48:"54",

/* Q49 options/expression incomplete */
q49:null,

q50:"8993"

};


let timeLeft = 30 * 60;

const timer = setInterval(function(){

    let minutes = Math.floor(timeLeft / 60);
    let seconds = timeLeft % 60;

    document.getElementById("time").textContent =
        String(minutes).padStart(2,"0") + ":" +
        String(seconds).padStart(2,"0");

    if(timeLeft <= 0){
        clearInterval(timer);
        submitTest();
    }

    timeLeft--;

},1000);


function submitTest(){

    clearInterval(timer);

    let score = 0;
    let attempted = 0;
    let total = Object.keys(answers).length;

    let reviewHTML = "";

    for(let q in answers){

        let selected =
            document.querySelector(
                'input[name="' + q + '"]:checked'
            );

        if(selected){
            attempted++;
        }

        let correct = answers[q];

        if(correct !== null && selected &&
           selected.value === correct){

            score++;

            reviewHTML +=
            "<div class='correct'>✔ " +
            q.toUpperCase() +
            " — సరైన సమాధానం</div>";

        }else if(correct !== null && selected){

            reviewHTML +=
            "<div class='wrong'>✘ " +
            q.toUpperCase() +
            " — తప్పు సమాధానం</div>";

        }else if(correct === null){

            reviewHTML +=
            "<div>⚠️ " +
            q.toUpperCase() +
            " — ప్రశ్న/సమాధానం డేటా పూర్తి చేయాలి</div>";

        }else{

            reviewHTML +=
            "<div class='wrong'>✘ " +
            q.toUpperCase() +
            " — సమాధానం ఇవ్వలేదు</div>";
        }
    }


    let validQuestions =
        Object.values(answers).filter(x => x !== null).length;

    let percentage =
        validQuestions > 0
        ? ((score / validQuestions) * 100).toFixed(2)
        : 0;

    let name =
        document.getElementById("studentName").value.trim();

    if(name === ""){
        name = "విద్యార్థి";
    }

    document.getElementById("score").innerHTML =
        name + "<br>" +
        "Score: " + score + " / " + validQuestions;

    document.getElementById("percentage").innerHTML =
        "Percentage: " + percentage + "%<br>" +
        "Attempted: " + attempted + " / " + total;

    document.getElementById("review").innerHTML =
        reviewHTML;

    document.getElementById("result").style.display =
        "block";

    window.scrollTo({
        top:document.body.scrollHeight,
        behavior:"smooth"
    });

}

</script>

